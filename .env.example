# LLM Provider Configuration
# Options: claude-cli, oai, anthropic, google
# Use 'claude-cli' to use Claude Code CLI (subscription-based, no API key needed)
# Use API-based providers for pay-per-use models
LLM_PROVIDER=claude-cli

# API Keys (only needed if not using claude-cli)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Claude CLI Configuration (only used when LLM_PROVIDER=claude-cli)
# Path to claude command (default: claude)
CLAUDE_CLI_COMMAND=claude
# Timeout for Claude CLI calls in seconds (default: 300)
CLAUDE_CLI_TIMEOUT=300

# Set to false to disable anonymized telemetry
ANONYMIZED_TELEMETRY=false

# LogLevel: Set to debug to enable verbose logging, set to result to get results only. Available: result | debug | info
BROWSER_USE_LOGGING_LEVEL=info
